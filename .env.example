# AIRA on Meta: example settings. Copy to .env (repo root or backend/) and fill in.
# Every name maps 1:1 to a field in backend/aira/config.py (case-insensitive, no prefix).
# Never commit a real .env. In Cloud Run, keys come from Secret Manager (meta-aira-* secrets).

# ---- Meta Model API ----
# Leave empty to run fully offline in mock mode.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime

# Mock mode: 1 = every model call returns canned output (nothing billed). 0 = real calls.
# Unset = automatic: mock when MODEL_API_KEY is empty.
# AIRA_MOCK=1

# ---- Model per role ----
# "-contributor" variants are ~10x cheaper; switch to the standard ones for the recorded demo.
MODEL_AGENT=muse-spark-1.3-contributor
MODEL_READ=muse-spark-1.3-contributor
# Independent second reader (different generation, so the two reads do not fail alike).
MODEL_VERIFY=muse-spark-1.2-contributor
MODEL_SAM=sam-3.1
MODEL_ASR=muse-voice-transcribe-1.0
# minimal | low | medium | high
REASONING_EFFORT=minimal

# ---- Optional open-weights second reader (any OpenAI-compatible endpoint) ----
# When READER2_MODEL is set it replaces MODEL_VERIFY. For Glimmer on Modal (infra/modal_glimmer.py):
#   READER2_BASE_URL=https://<workspace>--meta-aira-glimmer-serve.modal.run/v1
#   READER2_MODEL=muse-glimmer-30b
#   READER2_API_KEY=<the VLLM_API_KEY from the Modal secret meta-aira-glimmer>
READER2_BASE_URL=
READER2_API_KEY=
READER2_MODEL=

# ---- Storage ----
# memory (local dev/tests) | firestore (Cloud Run)
STORE=memory
GCP_PROJECT=gemini-enterprise-475109
# Only ever the meta-aira database. Never "(default)" or "aira" (other live apps).
FIRESTORE_DB=meta-aira
SHOP_ID=aira-cricket

# ---- Voice ----
# JSON list of languages for speech recognition.
ASR_LANGUAGES=["Tamil","English","Hindi"]

# ---- Access ----
# Shared secret between the phone app / dashboard and the backend. Empty = open (local dev only).
APP_KEY=

# ---- Frontend build (Vite; read at build time by frontend/app and frontend/dashboard) ----
# PUBLIC URLs only. Never put APP_KEY or any secret in a VITE_ variable: it ships in the JS bundle.
# The phone gets APP_KEY from a privately shared link: https://meta-aira.web.app/?key=<APP_KEY>
# VITE_BACKEND_URL=http://localhost:8080
# VITE_BACKEND_WS=ws://localhost:8080/ws
